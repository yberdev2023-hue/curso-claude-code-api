{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run alembic *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)"
    ]
  }
}
